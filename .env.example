# Aura Music Environment Variables

PORT=4000
JWT_SECRET=your_jwt_secret_here

# Database
DB_HOST=localhost
DB_USER=admin
DB_PASSWORD=your_db_password
DB_NAME=aura_music_db

# Local uploads fallback/cache
UPLOAD_DIR=

# Cloudflare Turnstile
TURNSTILE_SECRET=

# Backblaze B2 Cloud Storage (S3-compatible)
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
